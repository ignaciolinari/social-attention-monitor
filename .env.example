# Social Attention Monitor (SAM) Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS - Required for live data collection
# =============================================================================

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT="SAM/0.3.1 by YourUsername"

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key_here
# Optional tuning:
# - relevance: stable but can repeat results across polls
# - date: more "latest uploads" (often better for polling)
YOUTUBE_SEARCH_ORDER=relevance
# Only consider videos published in the last N days
YOUTUBE_PUBLISHED_AFTER_DAYS=30

# TMDB API (https://www.themoviedb.org/settings/api)
# Use either v3 API key or v4 access token.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# Bluesky API (https://bsky.app/settings/app-passwords)
# Create an app password (DM access not required)
BLUESKY_IDENTIFIER=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_app_password_here

# =============================================================================
# DATABASE - PostgreSQL with TimescaleDB
# =============================================================================

# Local development
# These defaults match `docker-compose.yml` for local development.
# For production, use strong credentials and a managed database.
# POSTGRES_PORT=5432
POSTGRES_DB=sam
POSTGRES_USER=sam
POSTGRES_PASSWORD=sam

DATABASE_URL=postgresql+asyncpg://sam:sam@localhost:5432/sam
DATABASE_SYNC_URL=postgresql://sam:sam@localhost:5432/sam

# =============================================================================
# REDIS - Cache and message queue
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY
# =============================================================================

# API key for protecting mutation/admin endpoints.
# When set, the following endpoints require `Authorization: Bearer <key>`
# or `X-API-Key: <key>` headers:
#   - PUT /api/v1/collectors/{platform}/toggle
#   - POST /api/v1/alerts/run-detection
#   - POST /api/v1/alerts/{id}/acknowledge
#   - All PUT/DELETE on /api/* paths
# SAM_API_KEY=your_secret_key

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development, staging, production
SAM_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Emit structured JSON logs (for log aggregators in production)
LOG_JSON=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8501
# Dashboard HTTP timeout (seconds)
SAM_DASHBOARD_HTTP_TIMEOUT=10
# Optional: full API base URL when Dashboard runs in Docker or remote context
# SAM_API_BASE_URL=http://api:8000

# Mentions refresh staleness (minutes)
MENTIONS_REFRESH_STALE_MINUTES=30

# =============================================================================
# COLLECTION SETTINGS
# =============================================================================

# Collector toggles — disable a platform without removing API keys.
# Reddit defaults to false (requires API keys); YouTube and Bluesky default to true.
REDDIT_ENABLED=false
YOUTUBE_ENABLED=true
BLUESKY_ENABLED=true

# Polling interval in minutes
POLLING_INTERVAL_MINUTES=30

# Target subreddits (comma-separated)
TARGET_SUBREDDITS=movies,television,netflix,DisneyPlus,amazonprime,appletv

# Maximum posts to fetch per subreddit per poll
MAX_POSTS_PER_SUBREDDIT=100

# =============================================================================
# DEMO MODE - Use mock data without API keys
# =============================================================================

# Set to true to use generated demo data instead of live APIs
DEMO_MODE=true

# Preferred env var in SAM (takes precedence if both are set)
SAM_DEMO_MODE=true

# CORS allowlist (comma-separated). Use '*' only for local development.
CORS_ALLOW_ORIGINS=*

# Comma-separated proxy IPs allowed to supply X-Forwarded-For.
# Leave empty unless running behind a trusted reverse proxy.
TRUSTED_PROXIES=

# =============================================================================
# CACHE TTL SETTINGS (seconds)
# =============================================================================

# Cache TTL for trending endpoints
SAM_CACHE_TTL_TRENDING=300

# Cache TTL for search endpoints
SAM_CACHE_TTL_SEARCH=300

# Cache TTL for metrics endpoints
SAM_CACHE_TTL_METRICS=60

# Cache TTL for pipeline health endpoint
SAM_CACHE_TTL_PIPELINE_HEALTH=30

# =============================================================================
# WEBSOCKET SETTINGS
# =============================================================================

# Interval for dead WebSocket connection cleanup (seconds)
SAM_WS_CLEANUP_INTERVAL=60

# =============================================================================
# RAW DATA STORAGE (optional)
# =============================================================================

# Enable persistence of raw collected data to local filesystem
SAM_STORAGE_ENABLE_RAW_DATA_STORAGE=false

# Directory for raw data dumps (JSONL files)
SAM_STORAGE_RAW_DATA_DIR=data/raw

# =============================================================================
# SENTIMENT ANALYSIS
# =============================================================================

# Sentiment model to use:
# - vader: Fast, rule-based (default)
# - roberta: Transformer-based (slower, more accurate)
# - both: Run both (stores VADER as primary, RoBERTa as secondary)
SENTIMENT_MODEL=vader

# Translate likely non-English content to English before sentiment analysis.
# English texts are skipped via local language detection.
SAM_TRANSLATE_BEFORE_SENTIMENT=false

# If true, falls back to VADER when the configured model fails to initialize.
# Set to false to fail fast when SENTIMENT_MODEL is unavailable.
SAM_SENTIMENT_FALLBACK_TO_VADER=true

# =============================================================================
# PIPELINE NLP / ENRICHMENT FLAGS
# =============================================================================

# Collect top-level YouTube comments in addition to videos.
SAM_ENABLE_YOUTUBE_COMMENTS=true

# Number of comments to collect per YouTube video (valid range: 1..100).
SAM_YOUTUBE_COMMENTS_PER_VIDEO=30

# Filter likely spam/bot content before sentiment analysis.
SAM_ENABLE_SPAM_FILTER=true

# Extract keyword/hashtag signals for alpha metrics pages.
SAM_ENABLE_KEYWORD_EXTRACTION=true

# Optional advanced NLP enrichments (require transformers support).
SAM_ENABLE_EMOTION_DETECTION=false
SAM_ENABLE_SARCASM_DETECTION=false

# Reserved for future aspect-based sentiment pipeline support.
SAM_ENABLE_ASPECT_SENTIMENT=false
